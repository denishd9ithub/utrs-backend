# Copy to .env and fill in your values
# cp .env.example .env

# Server
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database (for migrations - use Connection Pooler URL)
# DATABASE_POOLER_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Razorpay (Get from https://dashboard.razorpay.com → Settings → API Keys)
# Use Test keys (rzp_test_...) for development
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: for webhook signature verification
RAZORPAY_WEBHOOK_SECRET=

# HyperGuest
HYPERGUEST_AUTH_TOKEN=
HYPERGUEST_TEST_PROPERTY_ID=19912

# Roibos
ROIBOS_API_KEY=

# WhatsApp (Meta Business)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WEBHOOK_BASE_URL=

# OpenAI (for WhatsApp intent parsing)
OPENAI_API_KEY=

# Zoho Books (accounting)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_DEFAULT_CUSTOMER_ID=
